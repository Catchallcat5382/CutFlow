<Window x:Class="CutFlow.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Export" Width="760" Height="650" MinWidth="690" MinHeight="580"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True" ToolTipService.InitialShowDelay="220" ToolTipService.ShowDuration="12000">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="10" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource StrongLineBrush}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource WindowBrush}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="*"/><RowDefinition Height="68"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{DynamicResource TitleBrush}" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,0" VerticalAlignment="Center">
                    <TextBlock Text="Export" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProjectNameLabel" Text="" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource FlatButton}" Content="×" FontSize="18" Click="Cancel_Click" ToolTip="Close export"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="26,22,30,26">
                    <TextBlock Text="Export settings" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Choose the output just like a normal editor export. Original keeps the source FPS or resolution." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,20"/>

                    <Border Style="{StaticResource CardBorder}" Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Format" FontWeight="SemiBold"/><TextBlock Text="Video or audio file" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                                <ComboBox x:Name="FormatCombo" Grid.Column="1" SelectionChanged="FormatCombo_SelectionChanged">
                                    <ComboBoxItem Content="MP4"/><ComboBoxItem Content="MOV"/><ComboBoxItem Content="MKV"/><ComboBoxItem Content="MP3"/><ComboBoxItem Content="WAV"/><ComboBoxItem Content="M4A"/>
                                </ComboBox>
                            </Grid>

                            <Grid x:Name="VideoOptionsPanel" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Resolution" FontWeight="SemiBold"/><TextBlock Text="Keeps project aspect ratio" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                                <ComboBox x:Name="ResolutionCombo" Grid.Column="1" SelectionChanged="ExportSetting_SelectionChanged">
                                    <ComboBoxItem Content="Original"/><ComboBoxItem Content="2160p"/><ComboBoxItem Content="1440p"/><ComboBoxItem Content="1080p"/><ComboBoxItem Content="720p"/><ComboBoxItem Content="480p"/>
                                </ComboBox>
                            </Grid>

                            <Grid x:Name="FpsOptionsPanel" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Frame rate" FontWeight="SemiBold"/><TextBlock Text="Export FPS" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                                <ComboBox x:Name="FpsCombo" Grid.Column="1" SelectionChanged="ExportSetting_SelectionChanged">
                                    <ComboBoxItem Content="Original"/><ComboBoxItem Content="120 fps" Tag="120"/><ComboBoxItem Content="60 fps" Tag="60"/><ComboBoxItem Content="50 fps" Tag="50"/><ComboBoxItem Content="30 fps" Tag="30"/><ComboBoxItem Content="25 fps" Tag="25"/><ComboBoxItem Content="24 fps" Tag="24"/>
                                </ComboBox>
                            </Grid>

                            <Grid x:Name="QualityOptionsPanel" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Video quality" FontWeight="SemiBold"/><TextBlock Text="Higher = larger file" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                                <ComboBox x:Name="QualityCombo" Grid.Column="1" SelectionChanged="ExportSetting_SelectionChanged">
                                    <ComboBoxItem Content="Highest" Tag="16"/><ComboBoxItem Content="High — recommended" Tag="18"/><ComboBoxItem Content="Balanced" Tag="21"/>
                                </ComboBox>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Audio quality" FontWeight="SemiBold"/><TextBlock Text="Source level is preserved" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
                                <ComboBox x:Name="AudioQualityCombo" Grid.Column="1" SelectionChanged="ExportSetting_SelectionChanged">
                                    <ComboBoxItem Content="320 kbps" Tag="320"/><ComboBoxItem Content="256 kbps — recommended" Tag="256"/><ComboBoxItem Content="192 kbps" Tag="192"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="Save to" FontWeight="SemiBold"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="DestinationBox" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource BaseButton}" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click"/>
                            </Grid>
                            <TextBlock x:Name="ExportSummary" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11.5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBrush}">
                <Grid Margin="18,0">
                    <TextBlock x:Name="SourceInfoLabel" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="11.5" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource BaseButton}" Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Export" Padding="22,8" Click="Export_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
