<Window x:Class="CutFlow.RenderMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" Height="286"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="Foreground" Value="#F4F6F5"/>
        </Style>
    </Window.Resources>
    <Border Background="#F21C1E1D" BorderBrush="#4AFFFFFF" BorderThickness="1" CornerRadius="16" Padding="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.34" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" CornerRadius="9" Background="#263FA66A" BorderBrush="#5A62C58A" BorderThickness="1">
                    <Grid>
                        <Path Data="M 7,17 L 14,24 L 27,10" Stroke="#78D49A" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock x:Name="TitleText" Text="Applying cuts" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProjectText" Text="CutFlow project" Foreground="#A9B0AC" FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StageText" Grid.Row="1" Text="Preparing media engine…" FontSize="13.5" Margin="0,18,0,0" TextWrapping="Wrap"/>

            <Grid Grid.Row="2" Margin="0,13,0,0">
                <Border x:Name="ProgressTrack" Height="12" CornerRadius="6" Background="#303533" BorderBrush="#454B48" BorderThickness="1" ClipToBounds="True">
                    <Grid HorizontalAlignment="Stretch">
                        <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="5" Background="#58B97C">
                            <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.30" Color="#58B97C"/></Border.Effect>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="TimeText" Text="Estimating time…" Foreground="#B7BDB9" FontSize="12.5"/>
                <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontWeight="SemiBold" FontSize="12.5"/>
            </Grid>

            <Border Grid.Row="4" Background="#1D2A2320" BorderBrush="#405C4A3B" BorderThickness="1" CornerRadius="9" Padding="11,9" Margin="0,15,0,0">
                <TextBlock x:Name="WarningText" Foreground="#D9C4A3" FontSize="12.25" TextWrapping="Wrap"
                           Text="DO NOT CLOSE THE EDITOR while cuts are being applied. If CutFlow says Not Responding, leave it alone—the background worker is still running. If the editor is force-closed, the render is cancelled and the saved project remains unchanged."/>
            </Border>

            <TextBlock Grid.Row="5" Margin="0,12,0,0" Foreground="#7F8983" FontSize="11.5" TextWrapping="Wrap"
                       Text="The original imported media is not overwritten. CutFlow only switches to the shortened working file after this processor verifies its duration."/>
        </Grid>
    </Border>
</Window>
